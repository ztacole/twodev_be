// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//// ========= Enums =========

enum gender {
  male
  female
}

enum tuk {
  sewaktu
  tempat_kerja
  mandiri
}

//// ========= Core RBAC & Users =========

model role {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(255)

  users user[]
}

model user {
  id       Int     @id @default(autoincrement())
  full_name     String  @db.VarChar(255)
  email    String  @unique @db.VarChar(255)
  password String  @db.VarChar(255)
  role_id  Int

  role     role     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessee assessee[]
  assessor assessor?
  admin    admin?
}

model admin {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  address    String   @db.VarChar(255)
  phone_no   String   @db.VarChar(255)
  birth_date DateTime

  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= Master Data (Schemes, Occupations) =========

model scheme {
  id    Int    @id @default(autoincrement())
  code  String @db.VarChar(255)
  name  String @db.VarChar(255)

  occupations occupation[]
  assessors   assessor[]
}

model occupation {
  id        Int      @id @default(autoincrement())
  scheme_id Int
  name      String   @db.VarChar(255)

  scheme    scheme  @relation(fields: [scheme_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assessments assessment[]
}

//// ========= Personae =========

model assessor {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  scheme_id  Int
  address    String    @db.VarChar(255)
  phone_no   String    @db.VarChar(255)
  birth_date DateTime

  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheme     scheme   @relation(fields: [scheme_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assessment_details schedule_detail[]
  details            assessor_detail?
  results            result[]        @relation("assessor_results")
}

model assessor_detail {
  id              Int    @id @default(autoincrement())
  assessor_id     Int    @unique
  tax_id_number   String @db.VarChar(255)
  bank_book_cover String @db.VarChar(255)
  certificate     String @db.VarChar(255)
  national_id     String @db.VarChar(255)

  assessor        assessor @relation(fields: [assessor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model assessee {
  id                         Int      @id @default(autoincrement())
  user_id                    Int      
  identity_number            String   @db.VarChar(255)
  birth_date                 DateTime
  birth_location             String   @db.VarChar(255)
  gender                     gender
  nationality                String   @db.VarChar(255)
  phone_no                   String   @db.VarChar(255)
  house_phone_no             String?  @db.VarChar(255)
  office_phone_no            String?  @db.VarChar(255)
  address                    String   @db.VarChar(255)
  postal_code                String?  @db.VarChar(255)
  educational_qualifications String   @db.VarChar(255)

  user     user              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobs     assessee_job[]
  results  result[]          @relation("assessee_results")
}

model assessee_job {
  id               Int    @id @default(autoincrement())
  assessee_id      Int    @unique
  institution_name String @db.VarChar(255)
  address          String @db.VarChar(255)
  postal_code      String @db.VarChar(255)
  position         String @db.VarChar(255)
  phone_no         String @db.VarChar(255)
  job_email        String @db.VarChar(255)

  assessee assessee @relation(fields: [assessee_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= Assessment (generic) =========

model assessment {
  id            Int      @id @default(autoincrement())
  occupation_id Int
  code          String   @db.VarChar(255)

  occupation         occupation          @relation(fields: [occupation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessment_schedules assessment_schedule[]
  results             result[]
  groups_ia           group_ia[]
  uc_apl02s           uc_apl02[]
  ia05_questions      ia05_question[]
  ia07_questions      ia07_question[]
}

model assessment_schedule {
  id            Int               @id @default(autoincrement())
  assessment_id Int
  start_date    DateTime
  end_date      DateTime

  assessment       assessment        @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schedule_details schedule_detail[]
}

model schedule_detail {
  id           Int   @id @default(autoincrement())
  schedule_id  Int
  assessor_id  Int
  location     String @db.VarChar(255)

  schedule   assessment_schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessor   assessor            @relation(fields: [assessor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= Result (Umum + Dokumen) =========

model result {
  id            Int      @id @default(autoincrement())
  assessment_id Int
  assessor_id   Int
  assessee_id   Int
  is_competent  Boolean
  created_at    DateTime @default(now())
  tuk           tuk
  approved      Boolean  @default(false)

  assessment assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessor   assessor   @relation(fields: [assessor_id], references: [id], onDelete: Cascade, onUpdate: Cascade, name: "assessor_results")
  assessee   assessee   @relation(fields: [assessee_id], references: [id], onDelete: Cascade, onUpdate: Cascade, name: "assessee_results")

  docs    result_doc[]

  apl02_headers result_apl02_header[]
  ak01_headers  result_ak01_header[]
  ak02_headers  result_ak02_header[]
  ia01_headers  result_ia01_header[]
  ia02_headers  result_ia02_header[]
  ia03_headers  result_ia03_header[]
  ia05_headers  result_ia05_header[]
  ia07_headers  result_ia07_header[]
}

model result_doc {
  id                           Int    @id @default(autoincrement())
  result_id                    Int
  purpose                      String @db.VarChar(255)
  school_report_card           String @db.VarChar(255)
  field_work_practice_certificate String @db.VarChar(255)
  student_card                 String @db.VarChar(255)
  family_card                  String @db.VarChar(255)
  id_card                      String @db.VarChar(255)
  approved                     Boolean

  result   result   @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= APL02 =========

model uc_apl02 {
  id            Int    @id @default(autoincrement())
  assessment_id Int
  unit_code     String @db.VarChar(255)
  title         String @db.VarChar(255)

  assessment assessment    @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elements   element_apl02[]
  ak02_rows  result_ak02[]
}

model element_apl02 {
  id     Int    @id @default(autoincrement())
  uc_id  Int
  title  String @db.VarChar(255)

  uc       uc_apl02               @relation(fields: [uc_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  details  element_details_apl02[]
  results  result_apl02[]         
}

model element_details_apl02 {
  id          Int    @id @default(autoincrement())
  element_id  Int
  description String @db.Text

  element element_apl02 @relation(fields: [element_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model result_apl02_header {
  id        Int     @id @default(autoincrement())
  result_id Int
  approved  Boolean

  result result @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_apl02[]
}

model result_apl02 {
  id               Int  @id @default(autoincrement())
  result_apl02_id  Int
  element_id       Int
  is_competent     Boolean

  header  result_apl02_header @relation(fields: [result_apl02_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  element element_apl02       @relation(fields: [element_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  evidences apl02_evidence[]
}

model apl02_evidence {
  id              Int    @id @default(autoincrement())
  result_apl02_id Int
  evidence        String @db.VarChar(255)

  row result_apl02 @relation(fields: [result_apl02_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= AK01 / AK02 =========

model result_ak01_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result          @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ak01[]
}

model result_ak01 {
  id        Int    @id @default(autoincrement())
  header_id Int
  evidence  String @db.VarChar(255)

  header result_ak01_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model result_ak02_header {
  id                 Int     @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean
  is_competent       Boolean
  follow_up          String? @db.Text
  comment            String? @db.Text

  result result        @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ak02[]
}

model result_ak02 {
  id        Int    @id @default(autoincrement())
  header_id Int
  uc_id     Int
  evidence  String @db.VarChar(255)

  header result_ak02_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uc     uc_apl02           @relation(fields: [uc_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= IA02 / IA03 Struktur (Group & Tools & UC & Elements) =========

model group_ia {
  id             Int    @id @default(autoincrement())
  assessment_id  Int
  name           String @db.VarChar(255)
  scenario       String @db.Text
  duration       Int

  assessment assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tools      ia02_tool[]
  units      uc_ia[]
  qa_ia03    ia03_question[]
}

model ia02_tool {
  id       Int    @id @default(autoincrement())
  group_id Int
  name     String @db.VarChar(255)

  group group_ia @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model uc_ia {
  id       Int    @id @default(autoincrement())
  group_id Int
  unit_code String @db.VarChar(255)
  title     String @db.VarChar(255)

  group    group_ia  @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elements element_ia[]
}

model element_ia {
  id    Int    @id @default(autoincrement())
  uc_id Int
  title String @db.VarChar(255)

  uc      uc_ia              @relation(fields: [uc_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  details element_details_ia[]
}

model element_details_ia {
  id          Int    @id @default(autoincrement())
  element_id  Int
  description String @db.Text
  benchmark   String @db.VarChar(255)

  element element_ia @relation(fields: [element_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  results result_ia01[]
}

//// ========= IA01 =========

model result_ia01_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result        @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ia01[]
}

model result_ia01 {
  id                Int    @id @default(autoincrement())
  header_id         Int
  element_detail_id Int
  is_competent      Boolean
  evaluation        String @db.Text

  header        result_ia01_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  elementDetail element_details_ia @relation(fields: [element_detail_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= IA02 (header saja) =========

model result_ia02_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= IA03 (Q&A per Group) =========

model ia03_question {
  id       Int    @id @default(autoincrement())
  group_id Int
  question String @db.VarChar(255)

  group group_ia @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows  result_ia03[]
}

model result_ia03_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result        @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ia03[]
}

model result_ia03 {
  id         Int    @id @default(autoincrement())
  header_id  Int
  question_id Int
  answer     String @db.VarChar(255)
  approved   Boolean

  header   result_ia03_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question ia03_question      @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= IA05 (PG) =========

model ia05_question {
  id            Int    @id @default(autoincrement())
  assessment_id Int
  order         Int
  question      String @db.VarChar(255)

  assessment assessment     @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options    question_option[]
}

model question_option {
  id         Int    @id @default(autoincrement())
  question_id Int
  option     String @db.Text
  is_answer  Boolean

  question ia05_question @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows     result_ia05[]
}

model result_ia05_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result       @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ia05[]
}

model result_ia05 {
  id        Int    @id @default(autoincrement())
  header_id Int
  option_id Int
  approved  Boolean

  header result_ia05_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option question_option    @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

//// ========= IA07 (Essay/Kunci Jawaban) =========

model ia07_question {
  id            Int    @id @default(autoincrement())
  assessment_id Int
  question      String @db.Text
  answer_key    String @db.Text

  assessment assessment   @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows       result_ia07[]
}

model result_ia07_header {
  id                 Int  @id @default(autoincrement())
  result_id          Int
  approved_assessee  Boolean
  approved_assessor  Boolean

  result result       @relation(fields: [result_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rows   result_ia07[]
}

model result_ia07 {
  id         Int  @id @default(autoincrement())
  header_id  Int
  question_id Int
  approved   Boolean

  header   result_ia07_header @relation(fields: [header_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question ia07_question      @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}